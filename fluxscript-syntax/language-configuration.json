{
    "comments": {
        "lineComment": "//",
        "blockComment": [
            "--[[",
            "]]"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "'",
            "close": "'",
            "notIn": [
                "string",
                "comment"
            ]
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "indentationRules": {
        "increaseIndentPattern": "\\{[^}]*$",
        "decreaseIndentPattern": "^\\s*\\}"
    },
    "folding": {
        "markers": {
            "start": "^\\s*--\\[\\[",
            "end": "^\\s*\\]\\]"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d+|[A-Za-z_][A-Za-z_0-9]*)"
}
