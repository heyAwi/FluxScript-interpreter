{
    "name": "fluxscript-syntax",
    "displayName": "FluxScript",
    "description": "Syntax highlighting and editor support for FluxScript 1.1.0 (.flux)",
    "version": "1.1.0",
    "publisher": "fluxscript",
    "engines": {
        "vscode": "^1.70.2"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fluxscript",
                "aliases": [
                    "FluxScript",
                    "fluxscript"
                ],
                "extensions": [
                    ".flux"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fluxscript",
                "scopeName": "source.fluxscript",
                "path": "./syntaxes/fluxscript.tmLanguage.json"
            }
        ]
    }
}
